# Copy this file to .env for LOCAL development; .env is ignored by Git.
# Keep secrets server-only. Never use NEXT_PUBLIC_*, browser code, or hosting.json.
# Optional: leave empty to use deterministic plans without the online AI provider.
DEEPSEEK_API_KEY=

# Optional loopback-only Node24 API (npm run start:node), not the full React UI.
# Unset defaults: NODE_HOST=127.0.0.1, PORT=8788,
# VOCAB_DB_PATH=/tmp/vocab-wheel.sqlite. The parent directory must be writable.
# Uncomment to keep the local SQLite file in this checkout (ignored by Git):
# NODE_HOST=127.0.0.1
# PORT=8788
# VOCAB_DB_PATH=./vocab-wheel.local.sqlite

# Local full UI: npm run db:migrate then npm run dev.
# Its independent D1 state lives under .wrangler/state, not VOCAB_DB_PATH.
# Full UI / Sites use fixed site-owner; the standalone Node API uses local-owner.
# These namespaces are deliberately different. There is no owner/auth override.
# A hosted Site must remain owner-private; configure its key using Sites runtime
# secrets, never this public repository. Do not deploy the Node API publicly.
# Provider requests keep the existing fixed official endpoint and Flash/low model.
